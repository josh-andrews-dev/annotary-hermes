{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help:*)",
      "Bash(make build:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make ci:*)",
      "Bash(make standard-lint:*)"
    ],
    "ask": [
      "Edit(**/migrations/**)",
      "Write(**/migrations/**)",
      "Edit(**/alembic/versions/**)",
      "Write(**/alembic/versions/**)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)"
    ]
  }
}
